{
  "name": "storyteller",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "dev:all": "node scripts/dev.mjs",
    "build": "tsc --noEmit && tsc -p server --noEmit && vite build && node scripts/build-server.mjs",
    "build:app": "tsc --noEmit && vite build",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hono/node-server": "^2.1.3",
    "@preact/signals": "^2.3.1",
    "hono": "^4.13.13",
    "lucide-preact": "^1.47.0",
    "preact": "^10.29.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
